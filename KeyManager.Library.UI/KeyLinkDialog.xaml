<UserControl x:Class="Leosac.KeyManager.Library.UI.KeyLinkDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:Leosac.KeyManager.Library.UI.Domain"
             xmlns:converters="clr-namespace:Leosac.KeyManager.Library.UI.Converters"
             xmlns:local="clr-namespace:Leosac.KeyManager.Library.UI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:properties="clr-namespace:Leosac.KeyManager.Library.UI.Properties"
             xmlns:wpfappdomain="clr-namespace:Leosac.WpfApp.Domain;assembly=WpfApp"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance domain:KeyLinkDialogViewModel}"
             mc:Ignorable="d"
             MinWidth="300"
             d:DesignHeight="350" d:DesignWidth="500">
    <UserControl.Resources>
        <s:Boolean x:Key="True">True</s:Boolean>
        <s:Boolean x:Key="False">False</s:Boolean>
        <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <materialDesign:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
        <materialDesign:NullableToVisibilityConverter x:Key="ReverseNullableToVisibilityConverter" NullValue="Visible" NotNullValue="Collapsed" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </UserControl.Resources>
    <materialDesign:DrawerHost x:Name="DrawerHost" BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" BorderThickness="2">
        <materialDesign:DrawerHost.BottomDrawerContent>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{x:Static properties:Resources.LinkSuccess}" Margin="5" Visibility="{Binding LinkError, Converter={StaticResource ReverseNullableToVisibilityConverter}}" />
                <PasswordBox Margin="15"
                             materialDesign:PasswordBoxAssist.Password="{Binding LinkResult}"
                             IsEnabled="False"
                             Visibility="{Binding AllowImport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <WrapPanel Visibility="{Binding LinkError, Converter={StaticResource NullableToVisibilityConverter}}">
                    <TextBlock Margin="5" VerticalAlignment="Center" Text="{x:Static properties:Resources.LinkError}" />
                    <TextBlock Margin="5" VerticalAlignment="Center" Text="{Binding LinkError}" />
                </WrapPanel>
                <StackPanel Margin="15" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="5" VerticalAlignment="Center"
                            Command="{Binding ImportResultCommand}"
                            Content="IMPORT NOW"
                            Style="{StaticResource MaterialDesignFlatLightButton}" 
                            Visibility="{Binding AllowImport, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding LinkResult, Converter={StaticResource NullToBooleanConverter}}" />
                    <Button Margin="5" VerticalAlignment="Center"
                            Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}"
                            CommandParameter="{x:Static Dock.Bottom}"
                            Content="CLOSE"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:DrawerHost.BottomDrawerContent>
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static properties:Resources.KeyLink}" FontSize="18" Margin="5" />
            <TextBlock DockPanel.Dock="Top" Text="{x:Static properties:Resources.KeyLinkHelper}" Margin="5" />
            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,20,5,5">
                <materialDesign:Badged
                    Badge="{materialDesign:PackIcon Kind=Alert}"
                    BadgeColorZoneMode="SecondaryMid"
                    Margin="6">
                    <Button Width="120" Content="{x:Static properties:Resources.ImportNow}"
                            Style="{StaticResource MaterialDesignOutlinedLightButton}"
                            CommandParameter="{x:Static Dock.Bottom}" Command="{Binding RunLinkForImportCommand}" />
                </materialDesign:Badged>
                <Button Width="100" Content="{x:Static properties:Resources.Test}" Style="{StaticResource MaterialDesignRaisedLightButton}"
                        CommandParameter="{x:Static Dock.Bottom}"
                        Command="{Binding RunLinkCommand}" Margin="6" />
                <Button Width="100" IsDefault="True" Content="{x:Static properties:Resources.Close}" IsCancel="True" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" CommandParameter="{Binding Link}" Margin="6" />
            </WrapPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <local:KeyEntryReferenceControl Grid.Row="0" Grid.RowSpan="2"
                                                KeyStoreFavorite="{Binding Link.KeyStoreFavorite, Mode=TwoWay}"
                                                KeyEntryId="{Binding Link.KeyIdentifier, Mode=TwoWay}" />
                <TextBox Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding KeyLink.ContainerSelector, Mode=TwoWay}" Margin="5"
                         materialDesign:HintAssist.HelperText="{x:Static properties:Resources.KeyVersionHelper}"
                         materialDesign:HintAssist.Hint="{x:Static properties:Resources.KeyVersion}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                <local:DivInputControl Grid.Row="3" DivInput="{Binding Link.DivInput}" Margin="5, 15, 5, 5" />
            </Grid>
        </DockPanel>
    </materialDesign:DrawerHost>
</UserControl>
