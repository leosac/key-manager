<UserControl x:Class="Leosac.KeyManager.Library.UI.AsymmetricKeyControl"
             x:Name="keyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:Leosac.KeyManager.Library.UI.Domain"
             xmlns:converters="clr-namespace:Leosac.KeyManager.Library.UI.Converters"
             xmlns:local="clr-namespace:Leosac.KeyManager.Library.UI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:properties="clr-namespace:Leosac.KeyManager.Library.UI.Properties"
             xmlns:wpfappdomain="clr-namespace:Leosac.WpfApp.Domain;assembly=WpfApp"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BitLengthToCharLengthConverter x:Key="BitLengthToCharLengthConverter" />
            <converters:KeyChecksumConverter x:Key="KeyChecksumConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <local:KeyActionButtonsControl DockPanel.Dock="Top" Key="{Binding Path=Key, ElementName=keyControl}"
                               ShowKeyLink="{Binding Path=ShowKeyLink, ElementName=keyControl}"
                               ShowKeyGen="True" ShowMenu="False"
                               KClass="Asymmetric" HorizontalAlignment="Right" />
        <ListBox ItemsSource="{Binding Path=Key.Materials, ElementName=keyControl}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="{Binding Name}" />
                            <ComboBox Grid.Column="1" Margin="8,0,0,0"
                                      ItemsSource="{Binding Path=KeyFormats, ElementName=keyControl}"
                                      SelectedItem="{Binding Path=ValueFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="Key Format"
                                      SelectionChanged="KeyFormat_SelectionChanged" />
                            <local:KeyMaterialActionButtonsControl Grid.Column="2" KeyMaterial="{Binding}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBox Grid.Row="1" Margin="8,8,8,20" Width="380" Height="100"
                                     materialDesign:HintAssist.HelperText="{x:Static properties:Resources.KeyValueHelper}"
                                     materialDesign:HintAssist.Hint="{x:Static properties:Resources.KeyValue}"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
