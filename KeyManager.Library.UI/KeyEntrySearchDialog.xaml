<UserControl x:Class="Leosac.KeyManager.Library.UI.KeyEntrySearchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:Leosac.KeyManager.Library.UI.Domain"
             xmlns:converters="clr-namespace:Leosac.KeyManager.Library.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance domain:KeyEntrySearchDialogViewModel}"
             d:DesignHeight="450" d:DesignWidth="600"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Select a key entry" FontSize="18" Margin="0,0,0,12" />
        <TextBox Grid.Row="1" Text="{Binding SearchTerms, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                 materialDesign:HintAssist.Hint="Search by identifier or label"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Identifiers}"
                 SelectedItem="{Binding SelectedKeyEntryId, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="20,0,0,0" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" IsCancel="True" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="4" />
            <Button Content="SELECT" IsDefault="True" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{Binding SelectedKeyEntryId}" IsEnabled="{Binding SelectedKeyEntryId, Converter={StaticResource NullToBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" Margin="4" />
        </StackPanel>
    </Grid>
</UserControl>